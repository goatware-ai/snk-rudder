{
  "manifest_version": 3,
  "name": "Rudder Helper",
  "version": "1.0.0",
  "description": "Fill the Rudder comparison form from a task's payload.json: both rating sections, every failure-mode flag, the rationales and the preference.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rudder Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
